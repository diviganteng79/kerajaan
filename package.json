{
  "name": "kerajaan-auto",
  "version": "2.0.0",
  "private": true,
  "description": "Kerajaan Auto web/PWA offline-first dengan sinkronisasi Firebase dan siap dibungkus APK Capacitor.",
  "scripts": {
    "web": "npx serve static",
    "firebase:deploy": "npx firebase-tools deploy",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "latest",
    "@capacitor/cli": "latest",
    "@capacitor/core": "latest",
    "firebase-tools": "latest",
    "serve": "latest"
  }
}
